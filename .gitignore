*:Zone.Identifier
.DS_Store
Thumbs.db
.superpowers/

# Versioned on purpose even though the author's global gitignore hides them:
# project instructions, project skills, and the push-to-main guard hook.
!CLAUDE.md
!.claude/
.claude/*
!.claude/skills/
!.claude/hooks/
!.claude/settings.json

# design-sync
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# design canvas (seeded output — regenerate with seed-canvas.mjs from the .dc.html sources)
.design-canvas/**/*.html
!.design-canvas/**/*.dc.html

# mcp/
mcp/node_modules/
mcp/.env
mcp/*.tsbuildinfo
mcp/session*.json
mcp/.dev.vars
mcp/.wrangler/
mcp/worker-configuration.d.ts

# tools/cecotec (sharp, used only by make-thumbs.mjs)
tools/cecotec/node_modules/
