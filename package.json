{
  "name": "rezetapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:scripts": "esbuild scripts/migrate.ts scripts/seed.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist/scripts --out-extension:.js=.mjs --external:pg-native --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "i18n:check": "tsx scripts/check-i18n-keys.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm i18n:check && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.3",
    "next-intl": "4.13.7",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.47",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "ai": "7.0.79",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.25.12",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-boundaries": "7.2.0",
    "jsdom": "27.1.0",
    "shadcn": "4.19.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
