{
  "name": "rezet-mcp",
  "private": true,
  "version": "1.7.3",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "tsx src/index.ts",
    "login": "tsx src/login.ts",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "dev:worker": "wrangler dev -c wrangler.dev.jsonc",
    "types:worker": "wrangler types",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "@supabase/supabase-js": "2.115.0",
    "agents": "0.22.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260907.1",
    "@types/node": "^24.0.0",
    "tsx": "4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "4.129.0"
  }
}
