{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rezet-mcp",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "rezet-mcp.jarsss8.es", "custom_domain": true }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "5350cf523cc846ee93cb7e70974078f2" }],
  "vars": {
    "SUPABASE_URL": "https://raepigwmunhguzkmzukd.supabase.co",
    "PUBLIC_ORIGIN": "https://rezet-mcp.jarsss8.es",
    "APP_URL": "https://rezet.jarsss8.es",
    "REZET_TZ": "Europe/Madrid"
  },
  "secrets": { "required": ["SUPABASE_ANON_KEY"] },
  "observability": { "enabled": true }
}
