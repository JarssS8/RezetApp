{"id":"cecotec-sepia-con-verduras-en-olla-gm","sourceUrl":"https://cecotec.es/recetas/ollas-gm/sepia-con-verduras-en-olla-gm","publishedAt":null,"name":{"es":"Sepia con verduras","en":"Cuttlefish with vegetables"},"description":{"es":"","en":""},"appliances":["olla-gm"],"course":"main","tags":["olla-gm","main"],"baseServings":4,"servingsMax":null,"servingsUnit":"comensales","servingsText":"4","minutes":25,"minutesSource":"cecotec","timeBucket":"le30","difficulty":"easy","difficultySource":"cecotec","kcalPerServing":null,"photoUrl":"https://ecom-media-manager-prod.s3.amazonaws.com/image/7f0bb7d3-d12d-4551-af14-499a9c6ede0a.jpg","cookedCount":0,"ingredients":[{"ingredientId":"diente-de-ajo","quantity":2,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"2 dientes de ajo"},{"ingredientId":"sal","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Sal"},{"ingredientId":"pimienta","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Pimienta"},{"ingredientId":"aceite-de-oliva","quantity":25,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"25 g de aceite de oliva"},{"ingredientId":"tomillo","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Tomillo"},{"ingredientId":"tomate-triturado","quantity":150,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"150 g de tomate triturado"},{"ingredientId":"azucar","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Azúcar"},{"ingredientId":"pimiento-verde","quantity":75,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"75 g de pimiento verde"},{"ingredientId":"pimiento-amarillo","quantity":75,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"75 g de pimiento amarillo"},{"ingredientId":"cebolla","quantity":100,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"100 g de cebolla"},{"ingredientId":"calabacin","quantity":100,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"100 g de calabacín"},{"ingredientId":"sepia","quantity":375,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"375 g de sepia"}],"steps":[{"text":{"es":"Vertemos el aceite de oliva en la cubeta. Programamos el menú plancha durante 14 minutos, cuando alcance la temperatura, introducimos la cebolla, el ajo, el pimiento rojo, el pimiento amarillo y el calabacín en dados con una pizca de sal.","en":"Pour the olive oil into the bowl. Select the \"Plancha\" menu for 14 minutes, and once it reaches temperature, add the onion, garlic, red pepper, yellow pepper and diced courgette with a pinch of salt."},"timerMinutes":14},{"text":{"es":"Pasados 6 minutos, agregamos la sepia en dados pequeños y subimos la temperatura a 200ºC.","en":"After 6 minutes, add the cuttlefish in small dice and raise the temperature to 200 °C."},"timerMinutes":6,"temperatureC":200},{"text":{"es":"A continuación, programamos el menú plancha durante 5 minutos, añadimos el tomate triturado, una pizca de pimienta, tomillo y azúcar para la acidez del tomate.","en":"Next, select the \"Plancha\" menu for 5 minutes, add the crushed tomato, a pinch of pepper, thyme and sugar to balance the acidity of the tomato."},"timerMinutes":5},{"text":{"es":"Servimos con un poco de pan.","en":"Serve with a little bread."}}]}