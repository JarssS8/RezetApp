{"id":"cecotec-brochetas-de-gambas-especiadas","sourceUrl":"https://cecotec.es/recetas/cecofry/brochetas-de-gambas-especiadas","publishedAt":"2022-06-01T09:33:15+02:00","name":{"es":"Brochetas de gambas especiadas","en":"Spiced prawn skewers"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"starter","tags":["cecofry","starter"],"baseServings":2,"servingsMax":4,"servingsUnit":"comensales","servingsText":"2-4","minutes":15,"minutesSource":"cecotec","timeBucket":"le15","difficulty":"easy","difficultySource":"estimated","kcalPerServing":null,"photoUrl":"/ideas/photos/cecotec-brochetas-de-gambas-especiadas.jpg","cookedCount":0,"ingredients":[{"ingredientId":"pimenton","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de pimentón"},{"ingredientId":"gambon","quantity":12,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"12 gambones"},{"ingredientId":"sal","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ cucharadita de sal"},{"ingredientId":"ajo-en-polvo","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de ajo en polvo"},{"ingredientId":"pimienta-molida","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ cucharadita de pimienta molida"},{"ingredientId":"jengibre-en-polvo","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de jengibre en polvo"},{"ingredientId":"aceite-de-oliva","quantity":0.67,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"2 cucharaditas de aceite de oliva"}],"steps":[{"text":{"es":"Quitamos la cabeza de los gambones, y los pelamos dejando la parte final de la cola.","en":"Remove the heads from the king prawns and peel them, leaving the end of the tail on."}},{"text":{"es":"Precalentamos Cecofry a 200ºC durante 5 minutos.","en":"Preheat the Cecofry to 200 °C for 5 minutes."},"timerMinutes":5,"temperatureC":200},{"text":{"es":"Mezclamos en un bol el aceite, las especias y la sal y untamos los gambones por ambos lados.","en":"Mix the oil, spices and salt in a bowl and coat the prawns on both sides."}},{"text":{"es":"Pinchamos 4 gambones por palillo de brocheta.","en":"Thread 4 prawns onto each skewer."}},{"text":{"es":"Cocinamos durante 5 minutos a 200ºC, dando la vuelta a mitad de cocción.","en":"Cook for 5 minutes at 200 °C, turning halfway through cooking."},"timerMinutes":5,"temperatureC":200}]}