{"id":"cecotec-bikini-trufado-de-jamon-en-cecofry","sourceUrl":"https://cecotec.es/recetas/cecofry/bikini-trufado-de-jamon-en-cecofry","publishedAt":"2024-03-01T12:36:12+01:00","name":{"es":"Bikini trufado de jamón","en":"Truffled ham toastie"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"snack","tags":["cecofry","snack"],"baseServings":2,"servingsMax":null,"servingsUnit":"comensales","servingsText":"2","minutes":8,"minutesSource":"cecotec","timeBucket":"le15","difficulty":"easy","difficultySource":"estimated","kcalPerServing":null,"photoUrl":"/ideas/photos/cecotec-bikini-trufado-de-jamon-en-cecofry.jpg","cookedCount":0,"ingredients":[{"ingredientId":"rebanada-de-pan-de-molde","quantity":4,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"4 rebanadas de pan de molde"},{"ingredientId":"mantequilla","quantity":20,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"20 g de mantequilla"},{"ingredientId":"pasta-de-trufa","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Pasta de trufa"},{"ingredientId":"loncha-de-jamon-serrano","quantity":4,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"4 lonchas de jamón serrano"},{"ingredientId":"queso-de-tetilla","quantity":50,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"50 g de queso de tetilla"}],"steps":[{"text":{"es":"Pincelamos dos caras de las rebanadas de pan con la mantequilla y otras dos con pasta de trufa.","en":"Brush two of the bread slices with butter and the other two with truffle paste."}},{"text":{"es":"Colocamos encima de la pasta de trufa el jamón, el queso y cerramos con el pan dejado la mantequilla en la superficie.","en":"Place the ham and the cheese on top of the truffle paste, and close with the buttered slice, butter-side out."}},{"text":{"es":"Colocamos el sándwich en el interior de la cubeta y programa