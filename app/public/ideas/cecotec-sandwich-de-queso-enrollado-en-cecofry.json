{"id":"cecotec-sandwich-de-queso-enrollado-en-cecofry","sourceUrl":"https://cecotec.es/recetas/cecofry/sandwich-de-queso-enrollado-en-cecofry","publishedAt":"2022-09-09T11:01:19+02:00","name":{"es":"Sandwich de queso enrollado","en":"Rolled cheese sandwich"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"snack","tags":["cecofry","snack"],"baseServings":4,"servingsMax":null,"servingsUnit":"comensales","servingsText":"4","minutes":15,"minutesSource":"cecotec","timeBucket":"le15","difficulty":"easy","difficultySource":"estimated","kcalPerServing":null,"photoUrl":"https://ecom-media-manager-prod.s3.amazonaws.com/image/68c0f32e-0a09-4769-a2a4-2ada220ff89d.jpg","cookedCount":0,"ingredients":[{"ingredientId":"mayonesa","quantity":2,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"2 cucharadas de mayonesa"},{"ingredientId":"mantequilla","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Mantequilla"},{"ingredientId":"mostaza","quantity":1,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharada de mostaza"},{"ingredientId":"rebanada-de-pan-de-molde","quantity":8,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"8 rebanadas de pan de molde"},{"ingredientId":"loncha-de-queso-cheddar","quantity":8,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"8 lonchas de queso cheddar"}],"steps":[{"text":{"es":"Aplastamos las rebanadas de pan con un rodillo, ponemos encima las lonchas de queso y lo enrollamos.","en":"Flatten the bread slices with a rolling pin, place the cheese slices on top and roll up."}},{"text":{"es":"Colocamos los rollitos en la cubeta de la Cecofry y los pintamos con mantequilla, programamos 180ºC durante 12 minutos.","en":"Place the rolls in the Cecofry bowl and brush with butter, cook at 180 °C for 12 minutes."},"timerMinutes":12,"temperatureC":180},{"text":{"es":"Mezclamos la mayonesa con la mostaza para acompañar.","en":"Mix the mayonnaise with the mustard to serve alongside."}}]}