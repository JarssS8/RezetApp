{"id":"cecotec-coliflor-especiada","sourceUrl":"https://cecotec.es/recetas/cecofry/coliflor-especiada","publishedAt":"2022-06-14T12:29:26+02:00","name":{"es":"Coliflor especiada","en":"Spiced cauliflower"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"side","tags":["cecofry","side"],"baseServings":4,"servingsMax":null,"servingsUnit":"comensales","servingsText":"4","minutes":15,"minutesSource":"cecotec","timeBucket":"le15","difficulty":"easy","difficultySource":"estimated","kcalPerServing":null,"photoUrl":"/ideas/photos/cecotec-coliflor-especiada.jpg","cookedCount":0,"ingredients":[{"ingredientId":"comino","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ cucharadita de comino"},{"ingredientId":"curcuma","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ cucharadita de cúrcuma"},{"ingredientId":"pimenton-picante","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ cucharadita de pimentón picante"},{"ingredientId":"tahini","quantity":2,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"2 cucharadas de tahini"},{"ingredientId":"coliflor","quantity":400,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"400 g de coliflor"},{"ingredientId":"aceite-de-oliva","quantity":1,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharada de aceite de oliva"},{"ingredientId":"pimenton-dulce","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de pimentón dulce"},{"ingredientId":"sal","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de sal"},{"ingredientId":"pimienta","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ cucharadita de pimienta"}],"steps":[{"text":{"es":"Ponemos los ramilletes de coliflor en un bol, añadimos el tahini, el aceite de oliva, la sal, el pimentón dulce, el pimentón picante, la pimienta, la cúrcuma y el comino, mezclamos todo bien y lo introducimos en la Cecofry, programamos 180ºC durante 14 minutos.","en":"Put the cauliflower florets in a bowl, add the tahini, olive oil, salt, sweet paprika, hot paprika, pepper, turmeric and cumin, mix well and put it in the Cecofry, and set to 180 °C for 14 minutes."},"timerMinutes":14,"temperatureC":180},{"text":{"es":"Mientras tanto, mezclamos el yogur con el zumo de limón, el ajo en polvo, el perejil y salpimentamos.","en":"Meanwhile, mix the yoghurt with the lemon juice, garlic powder and parsley, and season with salt and pepper."}},{"text":{"es":"Servimos la coliflor acompañada de la salsa de yogur.","en":"Serve the cauliflower with the yoghurt sauce."}}]}