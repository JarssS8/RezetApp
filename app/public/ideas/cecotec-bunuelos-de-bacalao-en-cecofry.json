{"id":"cecotec-bunuelos-de-bacalao-en-cecofry","sourceUrl":"https://cecotec.es/recetas/cecofry/bunuelos-de-bacalao-en-cecofry","publishedAt":"2025-03-20T17:12:50+01:00","name":{"es":"Buñuelos de bacalao","en":"Cod fritters"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"starter","tags":["cecofry","starter"],"baseServings":4,"servingsMax":null,"servingsUnit":"comensales","servingsText":"4","minutes":30,"minutesSource":"cecotec","timeBucket":"le30","difficulty":"easy","difficultySource":"cecotec","kcalPerServing":null,"photoUrl":"/ideas/photos/cecotec-bunuelos-de-bacalao-en-cecofry.jpg","cookedCount":0,"ingredients":[{"ingredientId":"huevo","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 huevo"},{"ingredientId":"perejil","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Perejil"},{"ingredientId":"patata","quantity":375,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"375 g de patata"},{"ingredientId":"ajo-en-polvo","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de ajo en polvo"},{"ingredientId":"cebolla-en-polvo","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de cebolla en polvo"},{"ingredientId":"bacalao-desalado","quantity":250,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"250 g de bacalao desalado"}],"steps":[{"text":{"es":"Cocemos la patata con piel.","en":"Boil the potato with the skin on."}},{"text":{"es":"Ponemos el bacalao, el huevo, unas hojas de perejil, el ajo y la cebolla en polvo, trituramos.","en":"Put the cod, egg, a few parsley leaves and the garlic and onion powder in a blender, and blend."}},{"text":{"es":"Agregamos la patata pelada y troceada, picamos sin que quede del todo triturada la patata.","en":"Add the peeled and chopped potato, and pulse without fully blending the potato."}},{"text":{"es":"Formamos los buñuelos con dos cucharas y los colocamos en el interior de la cubeta de la Cecofry, programamos 200ºC durante 15 minutos.","en":"Shape the fritters with two spoons and place them inside the Cecofry basket, and set to 200 °C for 15 minutes."},"timerMinutes":15,"temperatureC":200},{"text":{"es":"Servimos con mayonesa o alioli.","en":"Serve with mayonnaise or aioli."}}]}