rejil","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":{"es":"Para las albóndigas","en":"For the meatballs"},"note":null,"sourceText":"Perejil"},{"ingredientId":"pan-rallado","quantity":50,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para las albóndigas","en":"For the meatballs"},"note":null,"sourceText":"50 g de pan rallado"},{"ingredientId":"sal","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":{"es":"Para las albóndigas","en":"For the meatballs"},"note":null,"sourceText":"Sal"},{"ingredientId":"carne-picada-de-ternera","quantity":275,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para las albóndigas","en":"For the meatballs"},"note":null,"sourceText":"275 g de carne picada de ternera"},{"ingredientId":"sal","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"Sal"},{"ingredientId":"pimienta","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"Pimienta"},{"ingredientId":"diente-de-ajo","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"1 diente de ajo"},{"ingredientId":"pimenton","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"½ cucharadita de pimentón"},{"ingredientId":"oregano","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"½ cucharadita de orégano"},{"ingredientId":"tomate-triturado","quantity":200,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"200 g de tomate triturado"},{"ingredientId":"cebolla","quantity":50,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"50 g de cebolla"},{"ingredientId":"pimiento-verde","quantity":50,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"50 g de pimiento verde"}],"steps":[{"text":{"es":"Ponemos en un bol la carne picada, el huevo, el ajo y la cebolla en polvo, el pan rallado, una pizca de sal, pimienta y perejil, formamos pequeñas albóndigas.","en":"Put the mince, egg, garlic and onion powder, breadcrumbs, a pinch of salt, pepper and parsley in a bowl, and shape into small meatballs."}},{"text":{"es":"Vertemos el aceite de oliva en la cubeta de la Olla y programamos el menú sofreír durante 10 minutos. Cuando alcance la temperatura introducimos las albóndigas, doramos por todos sus lados. Reservar.","en":"Pour the olive oil into the pot and set to the \"sofreír\" menu for 10 minutes. Once it reaches temperature, add the meatballs and brown on all sides. Set aside."},"timerMinutes":10},{"text":{"es":"A continuación, programamos el menú plancha durante 7 minutos, añadimos la cebolla, el pimiento y ajo picado con una pizca de sal.","en":"Next, set to the \"plancha\" menu for 7 minutes and add the onion, pepper and chopped garlic with a pinch of salt."},"timerMinutes":7},{"text":{"es":"Pasados 3 minutos, agregamos el pimentón, le damos unas vueltas y añadimos la salsa de tomate y el orégano.","en":"After 3 minutes, add the paprika, stir for a moment, then add the tomato sauce and the oregano."},"timerMinutes":3},{"text":{"es":"Rellenamos los panecillos, cubrimos con queso rallado y gratinamos con el cabezal freidora a 180ºC durante 6 minutos.","en":"Fill the buns, top with grated cheese and grill with the fryer head at 180 °C for 6 minutes."},"timerMinutes":6,"temperatureC":180},{"text":{"es":"Para terminar, añadimos una salsa de queso cheddar por encima y listo.","en":"To finish, add a cheddar cheese sauce over the top, and that's it."}}]}