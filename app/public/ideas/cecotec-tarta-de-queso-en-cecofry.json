 de nata para montar"},{"ingredientId":"parmesano-en-polvo","quantity":30,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para el relleno","en":"For the filling"},"note":null,"sourceText":"30 g de parmesano en polvo"},{"ingredientId":"queso-crema","quantity":300,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para el relleno","en":"For the filling"},"note":null,"sourceText":"300 g de queso crema"},{"ingredientId":"queso-fresco","quantity":70,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para el relleno","en":"For the filling"},"note":null,"sourceText":"70 g de queso fresco"}],"steps":[{"text":{"es":"Trituramos la galleta con la mantequilla.","en":"Blend the biscuits with the butter."}},{"text":{"es":"Extendemos la galleta en la base del molde desmontable de 18 cm, la chafamos para que se quede compacta. Metemos en la Cecofry 5 minutos a 200ºC.","en":"Spread the biscuit over the base of an 18 cm springform tin, pressing it down to compact it. Put it in the Cecofry for 5 minutes at 200 °C."},"timerMinutes":5,"temperatureC":200},{"text":{"es":"Trituramos el queso crema, la nata, los huevos, el queso fresco, el parmesano, el azúcar, la maicena y la sal.","en":"Blend the cream cheese, the cream, the eggs, the fresh cheese, the parmesan, the sugar, the cornflour and the salt."}},{"text":{"es":"Vertemos la mezcla sobre la galleta y programamos 170ºC durante 35 minutos.","en":"Pour the mixture over the biscuit base and cook at 170 °C for 35 minutes."},"timerMinutes":35,"temperatureC":170},{"text":{"es":"Retiramos de la cubeta y dejamos enfriar para poder desmoldar.","en":"Remove from the bowl and leave to cool before turning out."}}]}