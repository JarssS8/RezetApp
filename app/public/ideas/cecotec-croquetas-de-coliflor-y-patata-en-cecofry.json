{"id":"cecotec-croquetas-de-coliflor-y-patata-en-cecofry","sourceUrl":"https://cecotec.es/recetas/cecofry/croquetas-de-coliflor-y-patata-en-cecofry","publishedAt":"2022-12-22T18:01:26+01:00","name":{"es":"Croquetas de coliflor y patata","en":"Cauliflower and potato croquettes"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"starter","tags":["cecofry","starter"],"baseServings":4,"servingsMax":null,"servingsUnit":"comensales","servingsText":"4","minutes":20,"minutesSource":"cecotec","timeBucket":"le30","difficulty":"easy","difficultySource":"estimated","kcalPerServing":null,"photoUrl":"https://ecom-media-manager-prod.s3.amazonaws.com/image/4d47c91e-e3db-4d04-ab30-e258f56b1e2f.jpg","cookedCount":0,"ingredients":[{"ingredientId":"sal","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Sal"},{"ingredientId":"huevo","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 huevo"},{"ingredientId":"panko","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Panko"},{"ingredientId":"harina","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Harina"},{"ingredientId":"ajo-en-polvo","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de ajo en polvo"},{"ingredientId":"cebolla-en-polvo","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de cebolla en polvo"},{"ingredientId":"oregano","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de orégano"},{"ingredientId":"nuez-moscada","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ cucharadita de nuez moscada"},{"ingredientId":"patata","quantity":200,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"200 g de patata"},{"ingredientId":"coliflor","quantity":200,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"200 g de coliflor"},{"ingredientId":"pimienta","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ cucharadita de pimienta"}],"steps":[{"text":{"es":"Cocemos la patata y la coliflor.","en":"Boil the potato and cauliflower."}},{"text":{"es":"Machacamos la patata y la coliflor bien escurrida, añadimos el orégano, el ajo el polvo, la cebolla en polvo, la pimienta y la sal.","en":"Mash the potato and well-drained cauliflower, and add the oregano, garlic powder, onion powder, pepper and salt."}},{"text":{"es":"Le damos forma a las croquetas y las pasamos por harina, por huevo batido y por panko.","en":"Shape into croquettes and coat them in flour, beaten egg and panko."}},{"text":{"es":"Introducimos las croquetas en la cubeta de la Cecofry, echamos un poco de aceite en spray y programamos 200ºC durante 14 minutos.","en":"Put the croquettes in the Cecofry drawer, spray with a little oil and set to 200 °C for 14 minutes."},"timerMinutes":14,"temperatureC":200},{"text":{"es":"Opcional: Mezclamos dos cucharadas de mayonesa con una cucharadita de curry para acompañar las croquetas.","en":"Optional: mix two tablespoons of mayonnaise with a teaspoon of curry powder to serve with the croquettes."}}]}