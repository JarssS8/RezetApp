{"id":"cecotec-torrijas-de-horchata-en-cecofry","sourceUrl":"https://cecotec.es/recetas/cecofry/torrijas-de-horchata-en-cecofry","publishedAt":"2025-06-09T13:48:16+02:00","name":{"es":"Torrijas de horchata","en":"Horchata torrijas"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"dessert","tags":["cecofry","dessert"],"baseServings":4,"servingsMax":6,"servingsUnit":"comensales","servingsText":"4-6","minutes":30,"minutesSource":"cecotec","timeBucket":"le30","difficulty":"easy","difficultySource":"cecotec","kcalPerServing":null,"photoUrl":"/ideas/photos/cecotec-torrijas-de-horchata-en-cecofry.jpg","cookedCount":0,"ingredients":[{"ingredientId":"huevo","quantity":4,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"4 huevos"},{"ingredientId":"azucar","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Azúcar"},{"ingredientId":"canela","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Canela"},{"ingredientId":"horchata","quantity":500,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"500 g de horchata"},{"ingredientId":"rebanada-de-pan-brioche","quantity":4,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":{"es":"4-6","en":"4-6"},"sourceText":"4-6 rebanadas de pan brioche"},{"ingredientId":"helado-de-caramelo-salado","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Helado de caramelo salado"}],"steps":[{"text":{"es":"Mezclamos la horchata con dos huevos. Bañamos el pan en la horchata, 15 minutos por cada lado.","en":"Mix the horchata with two eggs. Soak the bread in the horchata, 15 minutes on each side."},"timerMinutes":15},{"text":{"es":"Pasamos el pan por huevo batido y lo colocamos con cuidado en la cubeta de la Cecofry, espolvoreamos con un poco de azúcar y canela y programamos 200ºC durante 10 minutos, con doble resistencia.","en":"Dip the bread in beaten egg and carefully place it in the Cecofry basket, sprinkle with a little sugar and cinnamon and set to 200 °C for 10 minutes, using both heating elements."},"timerMinutes":10,"temperatureC":200},{"text":{"es":"Servimos con una bola de helado.","en":"Serve with a scoop of ice cream."}}]}