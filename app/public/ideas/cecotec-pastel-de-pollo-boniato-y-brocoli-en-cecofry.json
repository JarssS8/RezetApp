{"id":"cecotec-pastel-de-pollo-boniato-y-brocoli-en-cecofry","sourceUrl":"https://cecotec.es/recetas/cecofry/pastel-de-pollo-boniato-y-brocoli-en-cecofry","publishedAt":null,"name":{"es":"Pastel de pollo, boniato y brócoli","en":"Chicken, sweet potato and broccoli bake"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"main","tags":["cecofry","main"],"baseServings":2,"servingsMax":null,"servingsUnit":"comensales","servingsText":"2","minutes":30,"minutesSource":"cecotec","timeBucket":"le30","difficulty":"easy","difficultySource":"cecotec","kcalPerServing":null,"photoUrl":"https://ecom-media-manager-prod.s3.amazonaws.com/image/d349c02e-5566-4c6a-8a61-d2b52ae4ea89.jpg","cookedCount":0,"ingredients":[{"ingredientId":"queso-crema","quantity":2,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"2 cucharadas de queso crema"},{"ingredientId":"ajo-en-polvo","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Ajo en polvo"},{"ingredientId":"cebolla-en-polvo","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Cebolla en polvo"},{"ingredientId":"hierba-provenzal","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Hierbas provenzales"},{"ingredientId":"sal","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Sal"},{"ingredientId":"pimienta","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Pimienta"},{"ingredientId":"leche","quantity":75,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"75 g de leche"},{"ingredientId":"huevo","quantity":2,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"2 huevos"},{"ingredientId":"queso-rallado","quantity":75,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"75 g de queso rallado"},{"ingredientId":"pechuga-de-pollo","quantity":300,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"300 g de pechuga"},{"ingredientId":"brocoli","quantity":100,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"100 g de brócoli"},{"ingredientId":"pimenton","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Pimentón"},{"ingredientId":"boniato","quantity":275,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"275 g de boniato"}],"steps":[{"text":{"es":"Cortamos en dados la pechuga y el boniato, lo ponemos en una bandeja y añadimos un chorrito de aceite, sal y las especias al gusto, mezclamos y cocinamos en la Cecofry a 190ºC durante 16 minutos.","en":"Dice the chicken breast and the sweet potato, put them on a tray and add a drizzle of oil, salt and the spices to taste, mix and cook in the Cecofry at 190 °C for 16 minutes."},"timerMinutes":16,"temperatureC":190},{"text":{"es":"Batimos los huevos con la leche, el queso crema, una pizca de sal y pimienta. Por otro lado, cocemos el brócoli.","en":"Beat the eggs with the milk, the cream cheese, a pinch of salt and pepper. Meanwhile, cook the broccoli."}},{"text":{"es":"Repartimos en la bandeja los ramilletes de brócoli, cubrimos con los huevos batidos y cocinamos a 180ºC durante 8 minutos.","en":"Scatter the broccoli florets over the tray, cover with the beaten eggs and cook at 180 °C for 8 minutes."},"timerMinutes":8,"temperatureC":180},{"text":{"es":"Espolvoreamos con el queso y terminamos de cocinar a 180ºC durante 4 minutos.","en":"Dust with the cheese and finish cooking at 180 °C for 4 minutes."},"timerMinutes":4,"temperatureC":180}]}