{"id":"cecotec-bolitas-de-patata-rancheras-en-cecofry","sourceUrl":"https://cecotec.es/recetas/cecofry/bolitas-de-patata-rancheras-en-cecofry","publishedAt":"2025-03-25T16:54:01+01:00","name":{"es":"Bolitas de patata rancheras","en":"Ranch potato bites"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"snack","tags":["cecofry","snack"],"baseServings":4,"servingsMax":null,"servingsUnit":"comensales","servingsText":"4","minutes":40,"minutesSource":"cecotec","timeBucket":"le60","difficulty":"medium","difficultySource":"cecotec","kcalPerServing":null,"photoUrl":"/ideas/photos/cecotec-bolitas-de-patata-rancheras-en-cecofry.jpg","cookedCount":0,"ingredients":[{"ingredientId":"ajo-en-polvo","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":{"es":"Para la salsa ranchera","en":"For the ranch sauce"},"note":null,"sourceText":"Ajo en polvo"},{"ingredientId":"sal","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":{"es":"Para la salsa ranchera","en":"For the ranch sauce"},"note":null,"sourceText":"Sal"},{"ingredientId":"pimienta","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":{"es":"Para la salsa ranchera","en":"For the ranch sauce"},"note":null,"sourceText":"Pimienta"},{"ingredientId":"mayonesa","quantity":75,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para la salsa ranchera","en":"For the ranch sauce"},"note":null,"sourceText":"75 g de mayonesa"},{"ingredientId":"nata-para-cocinar","quantity":35,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para la salsa ranchera","en":"For the ranch sauce"},"note":null,"sourceText":"35 g de nata para cocinar"},{"ingredientId":"zumo-de-limon","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":{"es":"Para la salsa ranchera","en":"For the ranch sauce"},"note":null,"sourceText":"1 cucharadita de zumo de limón"},{"ingredientId":"mozzarella-rallada","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Mozzarella rallada"},{"ingredientId":"patata-cocida","quantity":500,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"500 g de patata cocida"},{"ingredientId":"maicena","quantity":100,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"100 g de maicena"},{"ingredientId":"taquito-de-beicon","quantity":75,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"75 g de taquitos de beicon"}],"steps":[{"text":{"es":"Machacamos la patata y la mezclamos con la maicena, una pizca de sal y pimienta, nos untamos las manos en aceite y formamos las bolitas de patata.","en":"Mash the potato and mix it with the cornflour, a pinch of salt and pepper; oil your hands and shape the potato into balls."}},{"text":{"es":"Ponemos las bolitas en la cubeta de la Cecofry, echamos un poco de aceite en spray y programamos 200ºC durante 10 minutos.","en":"Put the balls in the Cecofry drawer, add a little spray oil, and set to 200 °C for 10 minutes."},"timerMinutes":10,"temperatureC":200},{"text":{"es":"Mientras tanto, mezclamos los ingredientes para la salsa ranchera.","en":"Meanwhile, mix the ingredients for the ranch sauce."}},{"text":{"es":"Ponemos las bolitas de patata en una bandeja, añadimos por encima la salsa, la mozzarella y los taquitos de beicon, cocinamos a 200ºC durante 6 minutos.","en":"Put the potato balls on a tray, add the sauce, the mozzarella and the bacon bits on top, and cook at 200 °C for 6 minutes."},"timerMinutes":6,"temperatureC":200},{"text":{"es":"Servimos.","en":"Serve."}}]}