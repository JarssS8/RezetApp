:null,"note":null,"sourceText":"1/2 cucharadita de cebolla en polvo"},{"ingredientId":"coliflor","quantity":0.5,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ coliflor"}],"steps":[{"text":{"es":"Mezclamos el aceite de oliva con el pimentón, el curry, el ajo en polvo, la cebolla en polvo, el comino y una pizca de sal.","en":"Mix the olive oil with the paprika, curry powder, garlic powder, onion powder, cumin and a pinch of salt."}},{"text":{"es":"Cortamos la coliflor en rodajas, la colocamos en la cubeta de la Cecofry y la pintamos con el aceite, programamos 175ºC durante 20 minutos.","en":"Cut the cauliflower into slices, place them in the Cecofry bowl and brush with the oil, then cook at 175 °C for 20 minutes."},"timerMinutes":20,"temperatureC":175},{"text":{"es":"Añadimos sobre la coliflor el queso rallado y una pizca de orégano, programamos 180ºC durante 5 minutos.","en":"Add the grated cheese and a pinch of oregano on top of the cauliflower, and cook at 180 °C for 5 minutes."},"timerMinutes":5,"temperatureC":180}]}