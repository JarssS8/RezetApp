{"id":"cecotec-roti-de-cochinillo-ahumado-en-cecofry","sourceUrl":"https://cecotec.es/recetas/cecofry/roti-de-cochinillo-ahumado-en-cecofry","publishedAt":null,"name":{"es":"Roti de cochinillo ahumado","en":"Smoked suckling pig roti"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"main","tags":["cecofry","main"],"baseServings":4,"servingsMax":6,"servingsUnit":"comensales","servingsText":"4-6","minutes":40,"minutesSource":"cecotec","timeBucket":"le60","difficulty":"easy","difficultySource":"cecotec","kcalPerServing":null,"photoUrl":"/ideas/photos/cecotec-roti-de-cochinillo-ahumado-en-cecofry.jpg","cookedCount":0,"ingredients":[{"ingredientId":"aceite-de-oliva","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Aceite de oliva"},{"ingredientId":"pimienta","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Pimienta"},{"ingredientId":"ajo-en-polvo","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de ajo en polvo"},{"ingredientId":"cebolla-en-polvo","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de cebolla en polvo"},{"ingredientId":"sal","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Sal"},{"ingredientId":"roti-de-cochinillo-de-tabladillo","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 roti de cochinillo de Tabladillo"},{"ingredientId":"patata-mini","quantity":350,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"350 g de patatas mini"},{"ingredientId":"pasta-de-trufa","quantity":0.67,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"2 cucharaditas de pasta de trufa"}],"steps":[{"text":{"es":"Ponemos los chips en la base de la cubeta, añadimos el cochinillo con una bandeja de papel y lo ahumamos. Mientras tanto, partimos las patatas por la mitad y las mezclamos con la pasta de trufa, el ajo y la cebolla en polvo, un chorrito de aceite y salpimentamos.","en":"Put the wood chips on the base of the basket, add the roti with a paper tray and smoke it. Meanwhile, cut the mini potatoes in half and mix them with the truffle paste, the garlic and onion powder, a drizzle of oil and season with salt and pepper."}},{"text":{"es":"Pincelamos el cochinillo con un poco de aceite de oliva y añadimos las patatas, programamos 200ºC durante 30 minutos.","en":"Brush the suckling pig with a little olive oil and add the potatoes, set to 200 °C for 30 minutes."},"timerMinutes":30,"temperatureC":200},{"text":{"es":"Trocemos en medallones y servimos.","en":"Cut into medallions and serve."}}]}