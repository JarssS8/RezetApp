{"id":"cecotec-saquitos-de-salmon-marinado-en-cecofry","sourceUrl":"https://cecotec.es/recetas/cecofry/saquitos-de-salmon-marinado-en-cecofry","publishedAt":"2023-09-25T13:25:08+02:00","name":{"es":"Saquitos de salmón marinado","en":"Marinated salmon parcels"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"starter","tags":["cecofry","starter"],"baseServings":2,"servingsMax":null,"servingsUnit":"comensales","servingsText":"2","minutes":20,"minutesSource":"cecotec","timeBucket":"le30","difficulty":"easy","difficultySource":"estimated","kcalPerServing":null,"photoUrl":"/ideas/photos/cecotec-saquitos-de-salmon-marinado-en-cecofry.jpg","cookedCount":0,"ingredients":[{"ingredientId":"pimienta","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Pimienta"},{"ingredientId":"aguacate","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 aguacate"},{"ingredientId":"sesamo","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Sésamo"},{"ingredientId":"lomo-de-salmon","quantity":2,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"2 lomos de salmón"},{"ingredientId":"salsa-de-soja","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Salsa de soja"},{"ingredientId":"ralladura-de-lima","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Ralladura de lima"},{"ingredientId":"aceite-de-sesamo","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de aceite de sésamo"},{"ingredientId":"papel-de-arroz","quantity":6,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"6 papeles de arroz"}],"steps":[{"text":{"es":"Troceamos el salmón, lo ponemos en un bol y añadimos salsa de soja, aceite de sésamo, pimienta y ralla