p":null,"note":null,"sourceText":"75 g de brócoli"},{"ingredientId":"champinon","quantity":75,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"75 g de champiñón"},{"ingredientId":"ajo-tierno","quantity":6,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"6 ajos tiernos"},{"ingredientId":"miso","quantity":1,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharada de miso"},{"ingredientId":"caldo-de-pollo","quantity":650,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"650 g de caldo de pollo"}],"steps":[{"text":{"es":"Vertemos el aceite de oliva en la cubeta, programamos el menú plancha durante 4 minutos. Cuando alcance la temperatura añadimos el champiñón laminado, el ajo picado y el ajo tierno troceado.","en":"Pour the olive oil into the bowl and select the \"Plancha\" menu for 4 minutes. Once it reaches temperature, add the sliced mushrooms, the chopped garlic and the chopped spring garlic."},"timerMinutes":4},{"text":{"es":"Agregamos las gyozas, los ramilletes de brócoli, la salsa de soja, el miso, el caldo, un poco de jengibre rallado y pimienta, programamos el menú pasta durante 2 minutos, cerramos la tapa y la válvula.","en":"Add the gyozas, the broccoli florets, the soy sauce, the miso, the stock, a little grated ginger and pepper, select the \"Pasta\" menu for 2 minutes, and close the lid and the valve."},"timerMinutes":2},{"text":{"es":"Despresurizamos para poder abrir la tapa, incorporamos los noodles y dejamos reposar 5 minutos para servir.","en":"Release the pressure to open the lid, add the noodles and leave to stand for 5 minutes before serving."},"timerMinutes":5}]}