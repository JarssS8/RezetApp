roup":null,"note":null,"sourceText":"½ granada"},{"ingredientId":"queso-feta","quantity":50,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"50 g de queso feta"},{"ingredientId":"champinon","quantity":100,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"100 g de champiñón"},{"ingredientId":"mezclum","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Mézclum"}],"steps":[{"text":{"es":"Pelamos y troceamos en daditos el boniato, cortamos el champiñón laminado.","en":"Peel and dice the sweet potato, and slice the mushrooms."}},{"text":{"es":"Programamos la cubeta del boniato a 180ºC durante 16 minutos, y la cubeta del champiñón a 175ºC durante 6 minutos.","en":"Cook the sweet potato bowl at 180 °C for 16 minutes, and the mushroom bowl at 175 °C for 6 minutes."},"timerMinutes":16,"temperatureC":180},{"text":{"es":"Mezclamos todos los ingredientes de la vinagreta hasta que estén emulsionados.","en":"Mix all the vinaigrette ingredients until emulsified."}},{"text":{"es":"En una ensaladera ponemos el mézclum, el boniato, los champiñones, el queso feta, la granada, unas nueces troceadas y añadimos la vinagreta.","en":"In a salad bowl, put the mixed salad leaves, sweet potato, mushrooms, feta cheese, pomegranate, a few chopped walnuts, and add the vinaigrette."}},{"text":{"es":"Mezclamos todo y listo.","en":"Mix everything together and it's ready."}}]}