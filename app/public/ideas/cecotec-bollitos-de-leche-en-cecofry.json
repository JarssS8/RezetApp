{"id":"cecotec-bollitos-de-leche-en-cecofry","sourceUrl":"https://cecotec.es/recetas/cecofry/bollitos-de-leche-en-cecofry","publishedAt":"2023-10-23T17:17:48+02:00","name":{"es":"Bollitos de leche","en":"Milk buns"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"bread","tags":["cecofry","bread"],"baseServings":9,"servingsMax":null,"servingsUnit":"unidades","servingsText":"9","minutes":90,"minutesSource":"cecotec","timeBucket":"gt60","difficulty":"medium","difficultySource":"estimated","kcalPerServing":null,"photoUrl":"https://ecom-media-manager-prod.s3.amazonaws.com/image/9bf43642-24af-4669-a7a4-9f4fcce06d76.jpg","cookedCount":0,"ingredients":[{"ingredientId":"leche","quantity":125,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"125 g de leche"},{"ingredientId":"mantequilla","quantity":50,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"50 g de mantequilla"},{"ingredientId":"azucar-moreno","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de azúcar moreno"},{"ingredientId":"harina","quantity":250,"unit":"g","toTaste":false,"optional":false,"group":null,"note":{"es":"250-275","en":"250-275"},"sourceText":"250-275 g de harina"},{"ingredientId":"levadura","quantity":6,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"6 g de levadura"},{"ingredientId":"sal","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ cucharadita de sal"}],"steps":[{"text":{"es":"Ponemos en un bol la leche tibia y la levadura, removemos para diluirla.","en":"Put the warm milk and yeast in a bowl and stir to dissolve."}},{"text":{"es":"Añadimos la mantequilla atemperada, el azúcar y la sal.","en":"Add the softened butter, sugar and salt."}},{"text":{"es":"Incorporamos la harina poco a poco hasta integrarla, amasamos hasta que la masa quede elástica. Dejamos reposar 45 minutos","en":"Gradually add the flour until incorporated, then knead until the dough is elastic. Leave to rest for 45 minutes."},"timerMinutes":45},{"text":{"es":"Dividimos la masa en 9 porciones iguales, colocamos las bolitas en la cubeta de la Cecofry y programamos 180ºC durante 7 minutos.","en":"Divide the dough into 9 equal portions, place the balls in the Cecofry basket and set to 180 °C for 7 minutes."},"timerMinutes":7,"temperatureC":180},{"text":{"es":"A continuación, programamos 160ºC durante 8 minutos.","en":"Then set to 160 °C for 8 minutes."},"timerMinutes":8,"temperatureC":160}]}