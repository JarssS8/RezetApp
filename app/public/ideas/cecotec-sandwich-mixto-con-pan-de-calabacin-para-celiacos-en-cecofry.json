{"id":"cecotec-sandwich-mixto-con-pan-de-calabacin-para-celiacos-en-cecofry","sourceUrl":"https://cecotec.es/recetas/cecofry/sandwich-mixto-con-pan-de-calabacin-para-celiacos-en-cecofry","publishedAt":"2023-07-26T13:14:56+02:00","name":{"es":"Sandwich mixto con pan de calabacín para celiacos","en":"Ham and cheese sandwich with courgette bread for coeliacs"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"snack","tags":["cecofry","snack"],"baseServings":2,"servingsMax":null,"servingsUnit":"comensales","servingsText":"2","minutes":30,"minutesSource":"cecotec","timeBucket":"le30","difficulty":"easy","difficultySource":"estimated","kcalPerServing":null,"photoUrl":"/ideas/photos/cecotec-sandwich-mixto-con-pan-de-calabacin-para-celiacos-en-cecofry.jpg","cookedCount":0,"ingredients":[{"ingredientId":"huevo","quantity":3,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"3 huevos"},{"ingredientId":"levadura-quimica","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de levadura química"},{"ingredientId":"loncha-de-jamon-de-york","quantity":4,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"4 lonchas de jamón de york"},{"ingredientId":"sal","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":{"es":"pizca","en":"pinch"},"sourceText":"Una pizca de sal"},{"ingredientId":"zumo-de-limon","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de zumo de limón"},{"ingredientId":"loncha-de-queso-gouda","quantity":4,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"4 lonchas de queso gouda"},{"ingredientId":"calabacin-rallado","quantity":100,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"100 g de calabacín rallado"},{"ingredientId":"almendra-molida","quantity":120,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"120 g de Harina de Almendra"},{"ingredientId":"aceite-de-oliva","quantity":5,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"5 g de aceite de oliva"}],"steps":[{"text":{"es":"Ponemos en un bol el calabacín con la harina de almendra, los huevos, el aceite, la levadura, el zumo de limón y una pizca de sal, mezclamos hasta conseguir una mezcla homogénea.","en":"Put the courgette in a bowl with the almond flour, eggs, oil, baking powder, lemon juice and a pinch of salt, and mix until smooth."}},{"text":{"es":"Vertemos en un molde con papel de horno y cocinamos en la Cecofrya 180ºC durante 20 minutos.","en":"Pour into a tin lined with baking paper and cook in the Cecofry at 180 °C for 20 minutes."},"timerMinutes":20,"temperatureC":180},{"text":{"es":"Desmoldamos, partimos por la mitad y lo rellenamos con el jamón y el queso. Lo llevamos de nuevo a la Cecofry y programamos 180ºC durante 4-6 minutos.","en":"Turn out, cut in half and fill with the ham and cheese. Put it back in the Cecofry and cook at 180 °C for 4-6 minutes."},"timerMinutes":6,"temperatureC":180}]}