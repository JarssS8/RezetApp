{"id":"cecotec-panecillos-de-yogur-y-queso-en-cecofry","sourceUrl":"https://cecotec.es/recetas/cecofry/panecillos-de-yogur-y-queso-en-cecofry","publishedAt":"2022-08-19T13:35:16+02:00","name":{"es":"Panecillos de yogur y queso","en":"Yoghurt and cheese rolls"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"bread","tags":["cecofry","bread"],"baseServings":4,"servingsMax":null,"servingsUnit":"comensales","servingsText":"4","minutes":20,"minutesSource":"cecotec","timeBucket":"le30","difficulty":"medium","difficultySource":"estimated","kcalPerServing":null,"photoUrl":"https://ecom-media-manager-prod.s3.amazonaws.com/image/8ff5cc62-c322-42bb-b080-c002fc4d174a.jpg","cookedCount":0,"ingredients":[{"ingredientId":"yogur-natural","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 yogur natural"},{"ingredientId":"azucar","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ cucharadita de azúcar"},{"ingredientId":"sal","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ cucharadita de sal"},{"ingredientId":"queso-parmesano-rallado","quantity":30,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"30 g de queso parmesano rallado"},{"ingredientId":"harina-de-trigo","quantity":175,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"175 g de harina de trigo"},{"ingredientId":"bicarbonato","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":{"es":"pizca","en":"pinch"},"sourceText":"1 pizca de bicarbonato"},{"ingredientId":"mantequilla","quantity":10,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"10 g de mantequilla"}],"steps":[{"text":{"es":"Mezclamos 1 yogur natural, 175 g de harina, 1 pizca de bicarbonato, 1 ⁄ 2 cucharadita de café de sal y 1 ⁄ 2 de azúcar, hasta obtener una masa homogénea.","en":"Mix 1 natural yoghurt, 175 g flour, 1 pinch of bicarbonate of soda, ½ teaspoon of salt and ½ of sugar, until you get an even dough."}},{"text":{"es":"Precalentamos Cecofry a 200ºC durante 5 minutos.","en":"Preheat the Cecofry to 200 °C for 5 minutes."},"timerMinutes":5,"temperatureC":200},{"text":{"es":"Dividimos la masa en 4 bolas y las aplastamos.","en":"Divide the dough into 4 balls and flatten them."}},{"text":{"es":"Ponemos un puñadito de queso en cada trozo de masa y la cerramos formando un saquito.","en":"Put a small handful of cheese on each piece of dough and close it up into a little parcel."}},{"text":{"es":"Agregamos encima un trocito de mantequilla.","en":"Add a small piece of butter on top."}},{"text":{"es":"Cocinamos durante 14 minutos a 200ºC.","en":"Cook for 14 minutes at 200 °C."},"timerMinutes":14,"temperatureC":200}]}