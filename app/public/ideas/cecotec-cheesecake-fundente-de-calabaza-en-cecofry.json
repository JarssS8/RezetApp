"note":null,"sourceText":"125 g de azúcar moreno"},{"ingredientId":"canela","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":{"es":"Para el relleno","en":"For the filling"},"note":null,"sourceText":"canela"},{"ingredientId":"jengibre","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":{"es":"Para el relleno","en":"For the filling"},"note":null,"sourceText":"jengibre"}],"steps":[{"text":{"es":"Introducimos las galletas y la mantequilla en la jarra de la Mambo, trituramos a velocidad 8 durante 8 segundos.","en":"Put the biscuits and butter into the Mambo jug and blitz on speed 8 for 8 seconds."}},{"text":{"es":"Extendemos la galleta en la base de nuestro molde, desmontable de 20 cm, y reservamos en el frigorífico.","en":"Spread the biscuit mixture over the base of a 20 cm springform tin and chill in the fridge."}},{"text":{"es":"Añadimos el queso crema, los huevos, la calabaza, el azúcar, la nata, una pizca de canela y otra de jengibre, programamos la velocidad 5 durante 20 segundos.","en":"Add the cream cheese, eggs, pumpkin, sugar, cream, a pinch of cinnamon and a pinch of ginger, and blend on speed 5 for 20 seconds."}},{"text":{"es":"Vertemos la mezcla sobre la galleta y cocinamos en la Cecofry 30 minutos a 160ºC.","en":"Pour the mixture over the biscuit base and cook in the Cecofry for 30 minutes at 160 °C."},"timerMinutes":30,"temperatureC":160},{"text":{"es":"Dejamos enfriar para poder desmoldar.","en":"Leave to cool before removing from the tin."}}]}