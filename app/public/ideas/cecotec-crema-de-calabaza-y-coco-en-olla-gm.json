{"id":"cecotec-crema-de-calabaza-y-coco-en-olla-gm","sourceUrl":"https://cecotec.es/recetas/ollas-gm/crema-de-calabaza-y-coco-en-olla-gm","publishedAt":null,"name":{"es":"Crema de calabaza y coco","en":"Cream of pumpkin and coconut"},"description":{"es":"","en":""},"appliances":["olla-gm"],"course":"starter","tags":["olla-gm","starter"],"baseServings":4,"servingsMax":null,"servingsUnit":"comensales","servingsText":"4","minutes":20,"minutesSource":"cecotec","timeBucket":"le30","difficulty":"easy","difficultySource":"cecotec","kcalPerServing":null,"photoUrl":"/ideas/photos/cecotec-crema-de-calabaza-y-coco-en-olla-gm.jpg","cookedCount":0,"ingredients":[{"ingredientId":"aceite-de-oliva","quantity":20,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"20 g de aceite de oliva"},{"ingredientId":"sal","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Sal"},{"ingredientId":"pimienta","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Pimienta"},{"ingredientId":"jamon-serrano","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Jamón serrano"},{"ingredientId":"puerro","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 puerro"},{"ingredientId":"cebolla","quantity":0.5,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ cebolla"},{"ingredientId":"leche-de-coco","quantity":150,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"150 g de leche de coco"},{"ingredientId":"patata","quantity":250,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"250 g de patata"},{"ingredientId":"calabaza","quantity":400,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"400 g de calabaza"},{"ingredientId":"caldo-de-pollo-o-verdura","quantity":300,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"300 g de caldo de pollo o verduras"},{"ingredientId":"nuez-moscada","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Nuez moscada"},{"ingredientId":"pipa-de-calabaza","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Pipas de calabaza"}],"steps":[{"text":{"es":"Vertemos el aceite de oliva en la cubeta, programamos el menú plancha durante 6 minutos. Cuando alcance la temperatura añadimos la cebolla y el puerro troceado con una pizca de sal.","en":"Pour the olive oil into the pot and select the \"Plancha\" programme for 6 minutes. Once it reaches temperature, add the onion and chopped leek with a pinch of salt."},"timerMinutes":6},{"text":{"es":"A continuación, agregamos la patata y la calabaza pelada y troceada, el caldo y las especias al gusto, programamos el menú presión durante 10 minutos, cerramos la tapa y la válvula.","en":"Next, add the peeled and chopped potato and pumpkin, the stock and spices to taste, and select the \"Presión\" programme for 10 minutes, closing the lid and the valve."},"timerMinutes":10},{"text":{"es":"Trituramos en un recipiente aparte y servimos con pipas de calabaza y jamón crujiente.","en":"Blend in a separate container and serve with pumpkin seeds and crispy ham."}}]}