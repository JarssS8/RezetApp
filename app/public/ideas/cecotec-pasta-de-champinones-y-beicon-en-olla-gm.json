{"id":"cecotec-pasta-de-champinones-y-beicon-en-olla-gm","sourceUrl":"https://cecotec.es/recetas/ollas-gm/pasta-de-champinones-y-beicon-en-olla-gm","publishedAt":null,"name":{"es":"Pasta de champiñones y beicon","en":"Mushroom and bacon pasta"},"description":{"es":"","en":""},"appliances":["olla-gm"],"course":"main","tags":["olla-gm","main"],"baseServings":2,"servingsMax":null,"servingsUnit":"comensales","servingsText":"2","minutes":15,"minutesSource":"cecotec","timeBucket":"le15","difficulty":"easy","difficultySource":"cecotec","kcalPerServing":null,"photoUrl":"https://ecom-media-manager-prod.s3.amazonaws.com/image/4227eade-3073-49c6-a0d2-52aa10ed7dab.jpg","cookedCount":0,"ingredients":[{"ingredientId":"queso-crema","quantity":2,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"2 cucharadas de queso crema"},{"ingredientId":"sal","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Sal"},{"ingredientId":"oregano","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Orégano"},{"ingredientId":"parmesano","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Parmesano"},{"ingredientId":"pimienta","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Pimienta"},{"ingredientId":"cebolla","quantity":75,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"75 g de cebolla"},{"ingredientId":"diente-de-ajo","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 diente de ajo"},{"ingredientId":"agua","quantity":400,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"400 g de agua"},{"ingredientId":"taquito-de-beicon","quantity":100,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"100 g de taquitos de beicon"},{"ingredientId":"champinon","quantity":120,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"120 g de champiñón"},{"ingredientId":"aceite-de-oliva","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Aceite de oliva"},{"ingredientId":"pasta-tiburon","quantity":200,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"200 g de pasta tiburón"}],"steps":[{"text":{"es":"Vertemos un chorrito de aceite de oliva en la cubeta, programamos el menú freír a 180ºC durante 7 minutos. Cuando alcance la temperatura, introducimos el beicon, la cebolla y el ajo picado.","en":"Pour a drizzle of olive oil into the bowl, set the fry menu to 180 °C for 7 minutes. Once it reaches temperature, add the bacon, the onion and the chopped garlic."},"timerMinutes":7,"temperatureC":180},{"text":{"es":"Pasados dos minutos, agregamos el champiñón troceado con una pizca de sal.","en":"After two minutes, add the chopped mushroom with a pinch of salt."}},{"text":{"es":"Agregamos la pasta, el agua, una pizca de orégano, sal y pimienta, programamos el menú presión durante 6 minutos.","en":"Add the pasta, the water, a pinch of oregano, salt and pepper, set the pressure menu for 6 minutes."},"timerMinutes":6},{"text":{"es":"Abrimos la tapa, añadimos un poco de parmesano y el queso crema, mezclamos todo bien y servimos.","en":"Open the lid, add a little parmesan and the cream cheese, mix everything well and serve."}}]}