uantity":2,"unit":"ud","toTaste":false,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"2 dientes de ajo"},{"ingredientId":"pimienta","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"Pimienta"},{"ingredientId":"nata-para-cocinar","quantity":200,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"200 g de nata para cocinar"},{"ingredientId":"cebolla-morada","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"1 cebolla morada"},{"ingredientId":"pimenton","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"1 cucharadita de pimentón"},{"ingredientId":"curcuma","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"1 cucharadita de cúrcuma"},{"ingredientId":"tomate-triturado","quantity":200,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"200 g de tomate triturado"},{"ingredientId":"mantequilla","quantity":50,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"50 g de mantequilla"},{"ingredientId":"sal","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"Sal"},{"ingredientId":"garam-masala","quantity":0.67,"unit":"tbsp","toTaste":false,"optional":false,"group":{"es":"Para la salsa","en":"For the sauce"},"note":null,"sourceText":"2 cucharaditas de garam masala"}],"steps":[{"text":{"es":"Troceamos el pollo y lo mezclamos con el yogur, el garam masala, la cúrcuma, el pimentón, una pizca de sal, otra de jengibre y un poco de jengibre rallado, dejamos macerar al menos 1 hora.","en":"Chop the chicken and mix it with the yoghurt, garam masala, turmeric, paprika, a pinch of salt, a pinch of ginger and a little grated ginger. Leave to marinate for at least 1 hour."},"timerMinutes":60},{"text":{"es":"Vertemos el aceite de oliva en la cubeta y programamos el menú sofreír durante 10 minutos. Cuando alcance la temperatura añadimos el pollo, reservar.","en":"Pour the olive oil into the pot and set to the \"sofreír\" menu for 10 minutes. Once it reaches temperature, add the chicken. Set aside."},"timerMinutes":10},{"text":{"es":"Echamos un poco más de aceite y programamos el menú plancha durante 10 minutos, agregamos la cebolla, el ajo, la mantequilla y una pizca de sal.","en":"Add a little more oil and set to the \"plancha\" menu for 10 minutes. Add the onion, garlic, butter and a pinch of salt."},"timerMinutes":10},{"text":{"es":"Pasados 4 minutos, incorporamos el garam masala, la cúrcuma, el pimentón y una pizca de sal, tostamos un minuto.","en":"After 4 minutes, add the garam masala, turmeric, paprika and a pinch of salt, and toast for a minute."},"timerMinutes":4},{"text":{"es":"Incorporamos el tomate y la nata para terminar de cocinar la salsa.","en":"Add the tomato and cream to finish cooking the sauce."}},{"text":{"es":"Trituramos la salsa y la ponemos otra vez en la cubeta, agregamos la carne y programamos el menú fuego lento durante 10 minutos.","en":"Blend the sauce and return it to the pot, add the chicken and set to the \"fuego lento\" menu for 10 minutes."},"timerMinutes":10},{"text":{"es":"Servimos.","en":"Serve."}}]}