{"id":"cecotec-dip-de-tomates-y-queso-en-cecofry","sourceUrl":"https://cecotec.es/recetas/cecofry/dip-de-tomates-y-queso-en-cecofry","publishedAt":"2022-10-31T16:51:51+01:00","name":{"es":"Dip de tomates y queso","en":"Tomato and cheese dip"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"sauce","tags":["cecofry","sauce"],"baseServings":4,"servingsMax":null,"servingsUnit":"comensales","servingsText":"4","minutes":15,"minutesSource":"cecotec","timeBucket":"le15","difficulty":"easy","difficultySource":"estimated","kcalPerServing":null,"photoUrl":"/ideas/photos/cecotec-dip-de-tomates-y-queso-en-cecofry.jpg","cookedCount":0,"ingredients":[{"ingredientId":"pimienta","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Pimienta"},{"ingredientId":"queso-crema","quantity":175,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"175 g de queso crema"},{"ingredientId":"ajo-en-polvo","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de ajo en polvo"},{"ingredientId":"aceite-de-oliva","quantity":10,"unit":"ml","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"10 ml de aceite de oliva"},{"ingredientId":"tomate-cherry","quantity":275,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"275 g de tomates Cherry"},{"ingredientId":"vinagre-de-modena","quantity":8,"unit":"ml","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"8 ml de vinagre de Módena"},{"ingredientId":"tomillo-romero","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Tomillo romero"}],"steps":[{"text":{"es":"Mezclamos en un molde apto para la Cecofry los tomates, el vinagre, el aceite, el ajo en polvo, el tomillo y el romero, introducimos en la cubeta y programamos 170ºC durante 12 minutos, el tiempo puede variar en función del tamaño del tomate.","en":"In a Cecofry-safe tin, mix the tomatoes, vinegar, oil, garlic powder, thyme and rosemary, place it in the bowl and cook at 170 °C for 12 minutes; the time may vary depending on the size of the tomatoes."},"timerMinutes":12,"temperatureC":170},{"text":{"es":"En un plato hondo extendemos el queso, ponemos encima los tomates y molemos un poco de pimienta, acompañamos con tostadas y listo.","en":"Spread the cheese over a deep plate, place the tomatoes on top and grind over a little pepper, and serve with toast."}}]}