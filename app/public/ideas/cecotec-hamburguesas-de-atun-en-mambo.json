n"},{"ingredientId":"calabacin","quantity":100,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"100 g de calabacín"}],"steps":[{"text":{"es":"Colocamos las cuchillas en su posición.","en":"Fit the blades in place."}},{"text":{"es":"Introducimos la cebolla, la zanahoria y el calabacín troceado, picamos a velocidad 9 para Mambo Cooking jarra V, y velocidad 6 para Mambo Touch, durante 5 segundos.","en":"Add the chopped onion, carrot and courgette, chop at speed 9 for Mambo Cooking jug V, and speed 6 for Mambo Touch, for 5 seconds."}},{"text":{"es":"Agregamos las latas de atún escurrido, los huevos, el ajo en polvo, la harina, una pizca de sal y otra de pimienta, mezclamos a velocidad 4 durante 20 segundos.","en":"Add the drained tins of tuna, the eggs, the garlic powder, the flour, a pinch of salt and a pinch of pepper, mix at speed 4 for 20 seconds."}},{"text":{"es":"Formamos las hamburguesas y las colocamos en la cubeta de la Cecofry con papel de horno, programamos 190ºC durante 15 minutos.","en":"Shape the burgers and place them in the Cecofry's basket with baking paper, cook at 190 °C for 15 minutes."},"timerMinutes":15,"temperatureC":190},{"text":{"es":"Servimos.","en":"Serve."}}]}