{"id":"cecotec-cheesecake-con-gominolas-vidal-en-cecofry","sourceUrl":"https://cecotec.es/recetas/cecofry/cheesecake-con-gominolas-vidal-en-cecofry","publishedAt":null,"name":{"es":"Cheesecake con gominolas Vidal","en":"Cheesecake with Vidal gummies"},"description":{"es":"","en":""},"appliances":["cecofry"],"course":"dessert","tags":["cecofry","dessert"],"baseServings":8,"servingsMax":null,"servingsUnit":"comensales","servingsText":"8","minutes":60,"minutesSource":"cecotec","timeBucket":"le60","difficulty":"easy","difficultySource":"cecotec","kcalPerServing":null,"photoUrl":"/ideas/photos/cecotec-cheesecake-con-gominolas-vidal-en-cecofry.jpg","cookedCount":0,"ingredients":[{"ingredientId":"mantequilla","quantity":75,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para la base","en":"For the base"},"note":null,"sourceText":"75 g de mantequilla"},{"ingredientId":"galleta","quantity":150,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para la base","en":"For the base"},"note":null,"sourceText":"150 g de galletas"},{"ingredientId":"azucar","quantity":50,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para el relleno","en":"For the filling"},"note":null,"sourceText":"50 g de azúcar"},{"ingredientId":"huevo","quantity":3,"unit":"ud","toTaste":false,"optional":false,"group":{"es":"Para el relleno","en":"For the filling"},"note":null,"sourceText":"3 huevos"},{"ingredientId":"nata-para-montar","quantity":200,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para el relleno","en":"For the filling"},"note":null,"sourceText":"200 g de nata para montar"},{"ingredientId":"queso-crema","quantity":400,"unit":"g","toTaste":false,"optional":false,"group":{"es":"Para el relleno","en":"For the filling"},"note":null,"sourceText":"400 g de queso crema"},{"ingredientId":"maicena","quantity":1,"unit":"tbsp","toTaste":false,"optional":false,"group":{"es":"Para el relleno","en":"For the filling"},"note":null,"sourceText":"1 cucharada de maicena"},{"i