{"id":"cecotec-potaje-de-cuaresma-en-olla-gm","sourceUrl":"https://cecotec.es/recetas/ollas-gm/potaje-de-cuaresma-en-olla-gm","publishedAt":"2024-03-27T13:55:29+01:00","name":{"es":"Potaje de cuaresma Olla GM","en":"Lenten stew"},"description":{"es":"","en":""},"appliances":["olla-gm"],"course":"main","tags":["olla-gm","main"],"baseServings":4,"servingsMax":null,"servingsUnit":"comensales","servingsText":"4","minutes":20,"minutesSource":"cecotec","timeBucket":"le30","difficulty":"easy","difficultySource":"estimated","kcalPerServing":null,"photoUrl":"https://ecom-media-manager-prod.s3.amazonaws.com/image/6c37e8ef-d968-4752-9e0b-2b42c4fe4b28.jpg","cookedCount":0,"ingredients":[{"ingredientId":"aceite-de-oliva","quantity":20,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"20 g de aceite de oliva"},{"ingredientId":"sal","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Sal"},{"ingredientId":"diente-de-ajo","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 diente de ajo"},{"ingredientId":"pimenton","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ cucharadita de pimentón"},{"ingredientId":"huevo-duro","quantity":2,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"2 huevos duros"},{"ingredientId":"cebolla","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cebolla"},{"ingredientId":"comino","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ cucharadita de comino"},{"ingredientId":"hoja-de-laurel","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 hoja de laurel"},{"ingredientId":"garbanzo-cocido","quantity":400,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"400 g de garbanzos cocidos"},{"ingredientId":"tomate-triturado","quantity":100,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"100 g de tomate triturado"},{"ingredientId":"caldo-de-pescado","quantity":400,"unit":"ml","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"400 ml de caldo de pescado"},{"ingredientId":"espinaca","quantity":200,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"200 g de espinacas"},{"ingredientId":"bacalao-desalado","quantity":200,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"200 g de bacalao desalado"}],"steps":[{"text":{"es":"Vertemos el aceite de oliva en la cubeta, programamos el menú plancha durante 6 minutos. Cuando alcance la temperatura añadimos la cebolla y el ajo picado con una pizca de sal.","en":"Pour the olive oil into the pot, select the \"Plancha\" menu for 6 minutes. Once it reaches temperature, add the onion and chopped garlic with a pinch of salt."},"timerMinutes":6},{"text":{"es":"Pasados 3 minutos, agregamos el tomate y el pimentón.","en":"After 3 minutes, add the tomato and the paprika."},"timerMinutes":3},{"text":{"es":"Incorporamos los garbanzos, el bacalao troceado, las espinacas, el laurel, el caldo, el comino y una pizca de sal, programamos el menú guiso durante 12 minutos, cerramos la tapa y la válvula.","en":"Add the chickpeas, the chopped cod, the spinach, the bay leaf, the stock, the cumin and a pinch of salt, select the \"Guiso\" menu for 12 minutes, close the lid and the valve."},"timerMinutes":12},{"text":{"es":"Despresurizamos para poder abrir la tapa y dejamos reposar unos minutos y servimos con los huevos picados y mezclado.","en":"Release the pressure to open the lid, leave to rest for a few minutes and serve with the chopped eggs mixed in."}}]}