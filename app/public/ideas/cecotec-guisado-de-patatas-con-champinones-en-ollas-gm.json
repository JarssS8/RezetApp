{"id":"cecotec-guisado-de-patatas-con-champinones-en-ollas-gm","sourceUrl":"https://cecotec.es/recetas/ollas-gm/guisado-de-patatas-con-champinones-en-ollas-gm","publishedAt":"2025-03-20T13:30:32+01:00","name":{"es":"Guisado de patatas con champiñones","en":"Potato and mushroom stew"},"description":{"es":"","en":""},"appliances":["olla-gm"],"course":"main","tags":["olla-gm","main"],"baseServings":4,"servingsMax":null,"servingsUnit":"comensales","servingsText":"4","minutes":20,"minutesSource":"cecotec","timeBucket":"le30","difficulty":"easy","difficultySource":"cecotec","kcalPerServing":null,"photoUrl":"/ideas/photos/cecotec-guisado-de-patatas-con-champinones-en-ollas-gm.jpg","cookedCount":0,"ingredients":[{"ingredientId":"aceite-de-oliva","quantity":20,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"20 g de aceite de oliva"},{"ingredientId":"sal","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Sal"},{"ingredientId":"pimienta","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Pimienta"},{"ingredientId":"cebolla","quantity":75,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"75 g de cebolla"},{"ingredientId":"diente-de-ajo","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 diente de ajo"},{"ingredientId":"pimenton","quantity":0.33,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 cucharadita de pimentón"},{"ingredientId":"curcuma","quantity":0.17,"unit":"tbsp","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"½ cucharadita de cúrcuma"},{"ingredientId":"hoja-de-laurel","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 hoja de laurel"},{"ingredientId":"patata","quantity":700,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"700 g de patata"},{"ingredientId":"champinon-laminado","quantity":150,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"150 g de champiñón laminado"},{"ingredientId":"taquito-de-jamon","quantity":100,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"100 g de taquitos de jamón"},{"ingredientId":"caldo-de-pollo","quantity":500,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"500 g de caldo de pollo"}],"steps":[{"text":{"es":"Vertemos el aceite de oliva en a cubeta, programamos el menú plancha durante 6 minutos. Cuando alcance la temperatura añadimos la cebolla y el ajo picado con una pizca de sal.","en":"Pour the olive oil into the pot, select the \"Plancha\" program for 6 minutes. When it reaches temperature, add the onion and chopped garlic with a pinch of salt."},"timerMinutes":6},{"text":{"es":"Pasados 3 minutos agregamos el champiñón.","en":"After 3 minutes, add the mushrooms."},"timerMinutes":3},{"text":{"es":"Finalizado el menú, añadimos los taquitos de jamón, el pimentón y la cúrcuma, removemos.","en":"When the programme ends, add the diced ham, the paprika and the turmeric, and stir."}},{"text":{"es":"Incorporamos la patata pelada y chascada, el caldo, el laurel y salpimentamos, programamos el menú turbo durante 10 minutos, cerramos la tapa y la válvula.","en":"Add the peeled and roughly broken potato, the stock, the bay leaf, and season with salt and pepper, select the \"Turbo\" program for 10 minutes, close the lid and the valve."},"timerMinutes":10},{"text":{"es":"Despresurizamos para poder abrir la tapa y dejamos reposar unos minutos antes de servir.","en":"Release the pressure to open the lid and leave to rest for a few minutes before serving."}}]}