{"id":"cecotec-crema-con-verduras-del-cocido-en-olla-gm","sourceUrl":"https://cecotec.es/recetas/ollas-gm/crema-con-verduras-del-cocido-en-olla-gm","publishedAt":"2024-04-15T15:37:42+02:00","name":{"es":"Crema con verduras del cocido","en":"Cream of cocido vegetables"},"description":{"es":"","en":""},"appliances":["olla-gm"],"course":"starter","tags":["olla-gm","starter"],"baseServings":4,"servingsMax":null,"servingsUnit":"comensales","servingsText":"4","minutes":20,"minutesSource":"cecotec","timeBucket":"le30","difficulty":"easy","difficultySource":"estimated","kcalPerServing":null,"photoUrl":"https://ecom-media-manager-prod.s3.amazonaws.com/image/4ec221a8-20f1-46a3-a973-1eae26ab7440.jpg","cookedCount":0,"ingredients":[{"ingredientId":"sal","quantity":null,"unit":null,"toTaste":true,"optional":false,"group":null,"note":null,"sourceText":"Sal"},{"ingredientId":"aceite-de-oliva","quantity":20,"unit":"ml","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"20 ml de aceite de oliva"},{"ingredientId":"chirivia","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 chirivía"},{"ingredientId":"nabo","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 nabo"},{"ingredientId":"puerro","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 puerro"},{"ingredientId":"ramita-de-apio","quantity":1,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"1 trozo de apio"},{"ingredientId":"zanahoria","quantity":3,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"3 zanahorias"},{"ingredientId":"patata","quantity":2,"unit":"ud","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"2 patatas"},{"ingredientId":"caldo-de-cocido","quantity":750,"unit":"ml","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"750 ml de caldo de cocido"}],"steps":[{"text":{"es":"Vertemos el aceite de oliva en la cubeta, programamos el menú plancha durante 5 minutos. Cuando alcance la temperatura añadimos el puerro y la zanahoria troceada con una pizca de sal.","en":"Pour the olive oil into the pot and select the \"Plancha\" programme for 5 minutes. Once it reaches temperature, add the leek and chopped carrot with a pinch of salt."},"timerMinutes":5},{"text":{"es":"Incorporamos el nabo, la chirivía y la patata pelada y troceada, el apio y el caldo, programamos el menú guiso durante 12 minutos, cerramos la tapa y la válvula.","en":"Add the turnip, parsnip, peeled and chopped potato, celery and stock, and select the \"Guiso\" programme for 12 minutes, closing the lid and the valve."},"timerMinutes":12},{"text":{"es":"Despresurizamos para poder abrir la tapa y trituramos en un recipiente aparte.","en":"Release the pressure to open the lid and blend in a separate container."}}]}