":false,"optional":false,"group":null,"note":null,"sourceText":"15 ml de aceite de oliva"},{"ingredientId":"jamon","quantity":75,"unit":"g","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"75 g jamón"},{"ingredientId":"agua","quantity":15,"unit":"ml","toTaste":false,"optional":false,"group":null,"note":null,"sourceText":"15 ml de agua"}],"steps":[{"text":{"es":"Introducimos las espinacas, el jamón, el ajo picado, el aceite y el agua en la cubeta de la Cecofry, programamos el menú sofreír 8 minutos.","en":"Put the spinach, the ham, the chopped garlic, the oil and the water in the Cecofry basket, and select the \"sofreír\" programme for 8 minutes."},"timerMinutes":8},{"text":{"es":"Mientras tanto, en un bol introducimos el resto de los ingredientes y mezclamos bien.","en":"Meanwhile, put the rest of the ingredients in a bowl and mix well."}},{"text":{"es":"Agregamos en el bol las espinacas con el jamón y unimos con la mezcla.","en":"Add the spinach and ham to the bowl and combine with the mixture."}},{"text":{"es":"Vertemos el relleno en moldes de silicona, los colocamos en la cubeta sin la pala y programamos el menú manual a 170 ºC durante 15 minutos.","en":"Pour the filling into silicone moulds, place them in the basket without the paddle, and select the \"Manual\" programme at 170 °C for 15 minutes."},"timerMinutes":15,"temperatureC":170}]}